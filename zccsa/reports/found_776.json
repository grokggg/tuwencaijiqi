<script src="https://rescdn.qqmail.com/node/wr/wrpage/js/eustia/errorPage$e73257ff.js"></script>
<script>
    function getEnv(ua) {
        if (ua == null) return 'unknown';

        ua = ua.toLowerCase();

        if (ua.indexOf('micromessenger') > -1) return 'weixin';
        if (ua.indexOf('mailapp') > -1) return 'mailapp';
        if (ua.indexOf('weread') > -1) return 'weread';

        return 'unknown';
    }

    function report() {

    }

    report();

    var isAppInstalled = false;
    var $bottom = _.$('.js_error_page_bottom');
    var $bottomText = _.$('.js_error_page_bottom_tip_text');
    var env = getEnv(window.navigator.userAgent);

    // 修改底部区域文案
    if (env === 'weread') {
        $bottomText.text('去书城发现更多好书');
        isAppInstalled = true;
    } else if (env === 'weixin') {
        $bottomText.text('去微信读书 App · 免费看更多书籍');
        _.isWrInstalled(function (isInstalled) {
            isAppInstalled = isInstalled;
        });
    } else {
        $bottomText.text('去微信读书 App · 免费看更多书籍');
        isAppInstalled = false;
    }

    // 底部区域点击事件
    $bottom.on('click', function () {
        _.reportWithPlat('click|bottom|promotion');
        if (isAppInstalled) {
            _.reportWithPlat('click|bottom|promotion|open');
            if (env === 'weread') {
                _.wrOpen({
                    openUrl: _.scheme('store')
                });
            } else {
                _.wrOpen({
                    openUrl: _.scheme('discover')
                });
            }
        } else {
            _.reportWithPlat('click|bottom|promotion|download');
            _.wrDownload();
        }
    });
</script>
</html>

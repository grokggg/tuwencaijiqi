<script>
    function getEnv(ua) {
        if (ua == null) return 'unknown';

        ua = ua.toLowerCase();

        if (ua.indexOf('micromessenger') > -1) return 'weixin';
        if (ua.indexOf('mailapp') > -1) return 'mailapp';
        if (ua.indexOf('weread') > -1) return 'weread';

        return 'unknown';
    }

    var env = getEnv(window.navigator.userAgent);

    if (env === 'weread') {
        /* eslint-disable */
        eval('window["__QMB_INFO__"]={apis:{"a":1,"b":1},ver:"4.0.5",os:"android"};window["__QMB_INFO_CALL__"]&&window["__QMB_INFO_CALL__"]();');
        (function () /** {$b5167ccadfb66ea3ba95d92d7c9946c9} */ {
            WeReadBridge = function () /** {$b9c7abd4d524a31563f1f27b768c47a9} */ {
                this._sendMessageQueue = [];
                this._callback_count = 1000;
                this._callback_map = {};
                this.available_func = {};
                this._iframe = document.createElement("iframe");
                this._iframe.setAttribute("id", "iframe");
                this._iframe.setAttribute("style", "position:absolute;top:0;left:0;width:1px;height:1px;visibility:hidden;");
                this._QUEUE_HAS_MESSAGE_URL = 'wereadapijs://dispatch_message/';
                document.body.appendChild(this._iframe);

                this._resultIframe = document.createElement("iframe");
                this._resultIframe.setAttribute("id", "_resultIframe");
                this._resultIframe.setAttribute("style", "position:absolute;top:0;left:0;width:1px;height:1px;visibility:hidden;");
                this._resultIframe._SET_RESULT_URL = 'wereadapijs://private/setresult/';
                document.body.appendChild(this._resultIframe);
            };

            window.callback = {};

            function wrapCallback(name, callback) {
                window.callback[name] = callback;
                return name;
            }

            /**
             * 跳转到某个url 这里即可以是app的某个模块 也可以是外部url
             * @url qqmail://ftn?a=b&c=d 或者 http://   @return successOrNot 成功返回YES，失败返回NO,并返回error字符串。
             */
            WeReadBridge.prototype.goToUrl = function (url, successCallback, failCallback) {
                var self = this;
                var params = {"url": url};
                this._call("goToUrl", params, function (successOrNot, result) {
                    var params = {"goToUrl": successOrNot};
                    self.localLog(params);
                    self._handleCallback(result, successOrNot, successCallback, failCallback);
                });
            };

            /**
             * 获取App的信息，包括version appName vid skey
             * @ver 1.1.1
             * @params successCallback(result) 从回调函数参数获得App 信息： result{version:String, appName:String, vid:String, skey:String, pf:String(v1.2), zoneid:String(v1.2), channelId:String(Android Only)}
             * @params failCallback(result)
             */
            WeReadBridge.prototype.getAppInfo = function (successCallback, failCallback) {
                var self = this;
                var params = {};
                this._call("getAppInfo", params, function (successOrNot, result) {
                    var params = {"getAppInfo": result};
                    self.localLog(params);
                    self._handleCallback(result, successOrNot, successCallback, failCallback);
                });
            };

            /**
             * 显示 Web Browser 右上角的更多操作: 分享给微信好友、分享到朋友圈、复制链接、在浏览器打开
             * @ver 1.1.1
             * @params {'shareToWechatFriend':0, 'shareToWechatTimeline':1, 'copyLink':0, 'openLinkWithBrowser':0, 'shareToWechatFriendParams':{...}, 'shareToWechatTimelineParams':{...}, 'osslogItemName': 'xxx' } 分别表示：分享给好友、分享到朋友圈、复制链接、用浏览器打开，0不显示 1显示；分享内容由shareToWechatFriendParams和shareToWechatTimelineParams 指定，格式同 shareToWechatTimeline()
             osslogItemName用于分享的打点统计，比如Share_To_WeChat_Session、Share_To_WeChat_Moment、Copy_Link、Open_Link_With_Browser后面再拼接'_$(osslogItemName)'就表示打点的itemName，logId=78502826
             */
            WeReadBridge.prototype.showBrowserMoreButton = function (params) {
                var self = this;
                this._call("showBrowserMoreButton", params, function (successOrNot, result) {
                    var params = {"showBrowserMoreButton": result};
                    self.localLog(params);
                });
            };

            /**
             * 将html里“weread-webview-”开头的meta封装成json然后提交给app
             * @ver iOS 2.1 && android 2.2
             * @params {}
             */
            WeReadBridge.prototype.updateConfigMeta = function (params) {
                var self = this;
                this._call("updateConfigMeta", params, function (successOrNot, result) {
                    var params = {"updateConfigMeta": result};
                    self.localLog(params);
                });
            };

            /**
             * @ver 1.1.1
             * 关闭当前 Web Browser
             */
            WeReadBridge.prototype.closeBrowser = function () {
                var self = this;
                var params = {};
                this._call("closeBrowser", params, function (successOrNot, result) {
                    var params = {"closeBrowser": result};
                    self.localLog(params);
                });
            };

            /**
             * 调用引导开启 Push 权限的弹窗。
             * @ver 2.4.9
             * @params {title: "开启推送通知", message: "开启推送通知后，分享免费领书籍更新后将第一时间提醒你。", confirmLogItem: "SystemPush_Fwd_ShareGetBook", from: "testFrom",forceShow: true}
             * 其中 confirmLogItem 是用户点“开启”时的统计 itemname，from 是曝光统计的 itemname。
             */
            WeReadBridge.prototype.adviceTurnOnPush = function (params, successCallback, failCallback) {
                var self = this;
                this._call("adviceTurnOnPush", params, function (successOrNot, result) {
                    var params = {"adviceTurnOnPush": result};
                    self.localLog(params);
                    self._handleCallback(result, successOrNot, successCallback, failCallback);
                });
            };

            /**
             * 调用mobileSync
             * @ver 1.1.1
             * @desc “veruszhong(钟文豪) 7-19 15:22:08 一个大量数据刷新的接口，根据刷回来的结果，可能会触发多个别的cgi的拉取。。” 具体看 cgi 协议里的 POST /mobileSync
             * @params successCallback(result) result={}
             * @params failCallback(result) result["error"]错误信息
             */
            WeReadBridge.prototype.mobileSync = function (successCallback, failCallback) {
                var self = this;
                var params = {};
                this._call("mobileSync", params, function (successOrNot, result) {
                    var params = {"mobileSync": result};
                    self.localLog(params);
                    self._handleCallback(result, successOrNot, successCallback, failCallback);
                });
            };

            /**
             * refreshToken 更新 skey 并返回
             * @ver 1.1.1
             * @params successCallback(result) result["skey"] 新的 skey
             * @params failCallback(result)   result["error"]错误信息
             */
            WeReadBridge.prototype.refreshToken = function (successCallback, failCallback) {
                var self = this;
                var params = {};
                this._call("refreshToken", params, function (successOrNot, result) {
                    var params = {"refreshToken": result};
                    self.localLog(params);
                    self._handleCallback(result, successOrNot, successCallback, failCallback);
                });
            };

            /**
             * refreshToken 更新 skey 并返回
             * @ver 2.3.2
             * @params params.refCgi 表示是由哪个cgi引起的refreshToken
             * @params successCallback(result) result["vid"]表示当前用户的vid，result["skey"] 新的 skey
             * @params failCallback(result)   result["error"]错误信息
             */
            WeReadBridge.prototype.refreshTokenWithParams = function (params, successCallback, failCallback) {
                var self = this;
                this._call("refreshToken", params, function (successOrNot, result) {
                    var params = {"refreshToken": result};
                    self.localLog(params);
                    self._handleCallback(result, successOrNot, successCallback, failCallback);
                });
            };

            /**
             * balanceSync 同步账户余额并返回
             * @ver 1.1.1
             * @params successCallback(result) result["balance"] 账户余额
             * @params failCallback(result)   result["error"]错误信息
             */
            WeReadBridge.prototype.balanceSync = function (successCallback, failCallback) {
                var self = this;
                var params = {};
                this._call("balanceSync", params, function (successOrNot, result) {
                    var params = {"balanceSync": result};
                    self.localLog(params);
                    self._handleCallback(result, successOrNot, successCallback, failCallback);
                });
            };

            /**
             * 分享到朋友
             * @ver 1.1.1
             * @params {'title':title,'imageUrl':imageUrl,'abstract':abstract,'url':url}
             * @params successCallback 成功回调
             * @params failCallback(result) 失败回调 result['error'] 1用户未安装微信
             */
            WeReadBridge.prototype.shareToWechatFriend = function (params, successCallback, failCallback) {
                this._shareToWechat(0, params, successCallback, failCallback);
            };

            /**
             * 分享到朋友圈
             * @ver 1.1.1
             * @params {'title':title,'imageUrl':imageUrl,'abstract':abstract,'url':url}
             * @params successCallback 成功回调
             * @params failCallback(result) 失败回调 result['error'] 1用户未安装微信
             */
            WeReadBridge.prototype.shareToWechatTimeline = function (params, successCallback, failCallback) {
                this._shareToWechat(1, params, successCallback, failCallback);
            };

            /**
             * 分享指定 type 的卡片图片给微信好友
             * @ver 2.1.0
             * @params {'type':1, 'title':title,'imageUrl':imageUrl,'abstract':abstract,'url':url}
             * @params successCallback 成功回调
             * @params failCallback(result) 失败回调 result['error'] 1用户未安装微信
             */
            WeReadBridge.prototype.shareImageToWechatFriend = function (params, successCallback, failCallback) {
                this._shareImageToWechat(0, params, successCallback, failCallback);
            };

            /**
             * 分享指定 type 的卡片图片给微信好友
             * @ver 2.1.0
             * @params {'type':1, 'title':title,'imageUrl':imageUrl,'abstract':abstract,'url':url}
             * @params successCallback 成功回调
             * @params failCallback(result) 失败回调 result['error'] 1用户未安装微信
             */
            WeReadBridge.prototype.shareImageToWechatTimeline = function (params, successCallback, failCallback) {
                this._shareImageToWechat(1, params, successCallback, failCallback);
            };

            /**
             * 将指定图片保存到本地
             * @params type 图片链接类型 0:未知, 1:h5url给app打开并截图, 2:图片url, 3:图片base64
             */
            WeReadBridge.prototype.saveImageToLocal = function (params, successCallback, failCallback) {
                var self = this;
                this._call("saveImageToLocal", params, function (successOrNot, result) {
                    self.localLog(params);
                    if (successOrNot) {
                        successCallback(result);
                    } else {
                        failCallback(result);
                    }
                });
            };

            WeReadBridge.prototype._shareImageToWechat = function (isTimeline, params, successCallback, failCallback) {
                var self = this;
                this._call(isTimeline ? "shareImageToWechatTimeline" : "shareImageToWechatFriend", params, function (successOrNot, result) /** {$73c8dd5b50e13e21a37e76c5c2eead04} */ {
                    var params = {"goToUrl": successOrNot};
                    self.localLog(params);
                    if (successOrNot) {
                        successCallback(result);
                    } else {
                        failCallback(result);
                    }
                });
            };

            /**
             * buyBook 弹起买书页面
             * @ver 1.2
             * @params params {'bookId':'641234'}
